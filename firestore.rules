rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: userId (UID)
    // Fields:
    //   - username: string (required)
    //   - isVerified: bool (required)
    //   - credits: int (required)
    //   - demographics: map (optional)
    //   - lastLogin: string (optional)
    //
    // Collection: questions
    // Document ID: questionId
    // Fields:
    //   - text: string (required)
    //   - options: list (required)
    //   - category: string (required)
    //   - authorUid: string (required)
    //   - isPublic: bool (required)
    //   - groupId: string (optional)
    //   - createdAt: string (required)
    //   - status: string (required, enum: pending, live, rejected)
    //
    // Collection: groups
    // Document ID: groupId
    // Fields:
    //   - name: string (required)
    //   - description: string (optional)
    //   - inviteCode: string (required)
    //   - adminUid: string (required)
    //   - members: list (required)
    //
    // Collection: games
    // Document ID: gameId
    // Fields:
    //   - type: string (required, enum: live, async)
    //   - status: string (required, enum: lobby, active, finished)
    //   - hostUid: string (required)
    //   - players: list (required)
    //   - questions: list (optional)
    //   - currentQuestionIndex: int (optional)
    //   - deadline: string (optional)
    //   - scores: map (optional)
    //   - predictions: map (optional)
    //   - answers: map (optional)
    //   - answers: map (optional)
    //   - inviteCode: string (required)
    //   - questionsPerPlayer: int (required)
    //   - createdAt: string (required)
    //   - lastUpdated: string (optional)
    //
    // Collection: game_questions
    // Document ID: questionId
    // Fields:
    //   - gameId: string (required)
    //   - authorUid: string (required)
    //   - authorUsername: string (required)
    //   - text: string (required)
    //   - options: list (required)
    //   - createdAt: string (required)
    //
    // ===============================================================

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    // Admin status keys on UID alone.
    //
    // It previously trusted `request.auth.token.email` against a list that
    // included ak@pulse.app and ahmedkhalil90@pulse.app -- but AuthProvider
    // builds every credential as `${username}@pulse.app`, so signing up with
    // the username `ak` produced a genuine token bearing an allow-listed
    // address. Registering a username granted full admin over every
    // collection. It also trusted users/{uid}.role, a field the owner could
    // write to their own profile.
    //
    // Both are gone. A UID is assigned by Firebase Auth and cannot be chosen,
    // and admins/{uid} is unreachable from any client -- see the match block
    // below. Nothing a signup can self-assert reaches this function.
    function isAdmin() {
      return isAuthenticated() &&
         (request.auth.uid == "7zNbw98m9jZYy8uTan7dqwolBud2" ||
          exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }
    function isSystem(data) {
      return data.authorUid == 'pulse_originals_system';
    }
    // Authorises re-parenting an older UID's data onto the caller, used when a
    // username has an orphaned profile under a previous UID (AuthProvider
    // signUp step 4, and the sign-in migration sweep).
    //
    // Proof of ownership is the caller's auth token, NOT a username field they
    // can write. Every account authenticates as `${username}@pulse.app`
    // (AuthProvider signUp/signIn), and Firebase Auth guarantees that address
    // is unique, so an attacker cannot claim someone else's username by
    // editing a Firestore document.
    function isMigrating(oldUid) {
      return isAuthenticated() &&
             request.auth.token.email != null &&
             exists(/databases/$(database)/documents/users/$(oldUid)) &&
             get(/databases/$(database)/documents/users/$(oldUid)).data.username is string &&
             request.auth.token.email.lower() ==
               get(/databases/$(database)/documents/users/$(oldUid)).data.username.lower() + '@pulse.app';
    }

    // Membership is a document, not an array entry -- see match /groups below.
    function isGroupMember(groupId) {
      return isAuthenticated()
             && exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
    }

    // Proof that the caller knew this group's CURRENT invite code.
    //
    // Existence alone would make the proof a bearer token: it outlives
    // membership, so an ex-member could re-admit themselves after the code was
    // rotated. Comparing the stored code against the group's live one means a
    // rotation invalidates every outstanding proof.
    function hasJoinProof(groupId, inviteCode) {
      return exists(/databases/$(database)/documents/groups/$(groupId)/joinRequests/$(request.auth.uid))
             && get(/databases/$(database)/documents/groups/$(groupId)/joinRequests/$(request.auth.uid)).data.code == inviteCode;
    }

    // A game map keyed by player UID (answers, predictions, playerQuestions):
    // only the caller's own key may change. An empty diff satisfies hasOnly,
    // so a write that leaves the map alone passes.
    function ownKeyOnly(oldData, newData, field) {
      return newData.get(field, {}).diff(oldData.get(field, {}))
               .affectedKeys().hasOnly([request.auth.uid]);
    }

    // A player may ADD their answer or prediction for a question, never change
    // or remove one already recorded.
    //
    // Without this, a player looking at the results screen -- which renders as
    // soon as everyone has answered and predicted, before the host advances --
    // could flip their own answer, move the majority, and rewrite every
    // player's score, because scoring reads the document at advance time.
    function ownEntriesAppendOnly(oldData, newData, field) {
      return newData.get(field, {}).get(request.auth.uid, {})
               .diff(oldData.get(field, {}).get(request.auth.uid, {}))
               .changedKeys().size() == 0
             && newData.get(field, {}).get(request.auth.uid, {})
                  .diff(oldData.get(field, {}).get(request.auth.uid, {}))
                  .removedKeys().size() == 0;
    }

    // Submitting questions: the list only ever grows, by exactly this game's
    // per-player quota, and only once per player.
    //
    // Plain containment was not enough. `hasAll` is a subset test, so it
    // permitted reordering -- which moves a chosen question to index 0, where
    // currentQuestionIndex starts -- as well as duplication and unbounded
    // padding. Requiring an exact size increase rejects a pure reorder, since
    // that leaves the size unchanged.
    //
    // A write that does not touch `questions` passes untouched, so answering
    // and predicting are unaffected.
    function questionSubmissionOk() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['questions'])
             || (request.resource.data.questions.hasAll(resource.data.get('questions', []))
                 && request.resource.data.questions.size()
                      == resource.data.get('questions', []).size() + resource.data.questionsPerPlayer
                 && !(request.auth.uid in resource.data.get('playerQuestions', {}).keys())
                 && request.resource.data.get('playerQuestions', {}).get(request.auth.uid, []).size()
                      == resource.data.questionsPerPlayer);
    }

    // Game status only ever moves forward: lobby -> active -> finished.
    //
    // Reverting a started game to 'lobby' would re-open the whole document to
    // any authenticated reader and let an outsider walk in through the join
    // branch, so the state machine is enforced here rather than only in the UI.
    // A write that leaves status alone passes.
    function gameStatusOk() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status'])
             || (resource.data.status == 'lobby' && request.resource.data.status == 'active')
             || (resource.data.status == 'active' && request.resource.data.status == 'finished');
    }

    // Domain Validators
    function isValidUser(data) {
      return data.username is string && data.username.size() > 0 &&
             data.isVerified is bool &&
             data.credits is int;
    }

    // ---------------------------------------------------------------
    // Vote integrity helpers (results/{questionId})
    // ---------------------------------------------------------------
    //
    // Answer IDs are deterministic: `${uid}_${questionId}`. The client writes
    // the answer record before touching results, so rules can verify a vote
    // against the caller's own recorded answer.

    function answerPath(questionId) {
      return /databases/$(database)/documents/user_answers/$(request.auth.uid + '_' + questionId);
    }
    // A vote counts only in the same write that creates the caller's answer
    // record, so a member who has answered cannot send the +1 again.
    function hasAnswered(questionId) {
      return existsAfter(answerPath(questionId))
        && !exists(answerPath(questionId));
    }
    // Returns '0' or '1' — the option the caller actually chose.
    function callerAnswerIndex(questionId) {
      return string(getAfter(answerPath(questionId)).data.answerIndex);
    }
    function callerDemographics() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('demographics', {});
    }
    function voteTotal(d) {
      return d.counts.get('0', 0) + d.counts.get('1', 0);
    }

    // One demographic category on first vote. The client writes both '0' and
    // '1' keys explicitly (one of them zero), so this checks the bucket sums
    // to exactly one vote, on the caller's own index.
    function demoCatCreateOk(newD, cat, bucket, idx) {
      return bucket == null
        ? newD.get(cat, {}).keys().size() == 0
        : newD.get(cat, {}).keys().hasOnly([bucket])
          && newD.get(cat, {}).get(bucket, {}).keys().hasOnly(['0', '1'])
          && newD.get(cat, {}).get(bucket, {}).get('0', 0) + newD.get(cat, {}).get(bucket, {}).get('1', 0) == 1
          && newD.get(cat, {}).get(bucket, {}).get(idx, 0) == 1;
    }
    function demoCreateOk(newD, idx) {
      return newD.keys().hasOnly(['ageRange', 'gender', 'country'])
        && demoCatCreateOk(newD, 'ageRange', callerDemographics().get('ageRange', null), idx)
        && demoCatCreateOk(newD, 'gender',   callerDemographics().get('gender', null), idx)
        && demoCatCreateOk(newD, 'country',  callerDemographics().get('country', null), idx);
    }

    // One demographic category on a subsequent vote: only the caller's own
    // bucket may change, and only by +1 on the caller's own index.
    function demoCatUpdateOk(newD, oldD, cat, bucket, idx) {
      return bucket == null
        // Caller has no value for this category — it must be left untouched.
        ? newD.get(cat, {}).diff(oldD.get(cat, {})).affectedKeys().size() == 0
        : newD.get(cat, {}).diff(oldD.get(cat, {})).affectedKeys().hasOnly([bucket])
          && newD.get(cat, {}).get(bucket, {}).diff(oldD.get(cat, {}).get(bucket, {})).affectedKeys().hasOnly([idx])
          && newD.get(cat, {}).get(bucket, {}).get(idx, 0)
               == oldD.get(cat, {}).get(bucket, {}).get(idx, 0) + 1;
    }
    function demoUpdateOk(newD, oldD, idx) {
      return newD.diff(oldD).affectedKeys().hasOnly(['ageRange', 'gender', 'country'])
        && demoCatUpdateOk(newD, oldD, 'ageRange', callerDemographics().get('ageRange', null), idx)
        && demoCatUpdateOk(newD, oldD, 'gender',   callerDemographics().get('gender', null), idx)
        && demoCatUpdateOk(newD, oldD, 'country',  callerDemographics().get('country', null), idx);
    }

    // ---------------------------------------------------------------
    // Question moderation helpers (questions/{questionId})
    // ---------------------------------------------------------------

    // A flag adds exactly one to the total and to exactly one reason counter.
    // `status` may only ever be set to 'flagged', and only once the auto-hide
    // threshold is genuinely reached.
    function isFlagWrite() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly(['flags', 'flags_unclear', 'flags_inappropriate', 'status'])
        && request.resource.data.flags == resource.data.get('flags', 0) + 1
        && request.resource.data.get('flags_unclear', 0) >= resource.data.get('flags_unclear', 0)
        && request.resource.data.get('flags_inappropriate', 0) >= resource.data.get('flags_inappropriate', 0)
        && request.resource.data.get('flags_unclear', 0) + request.resource.data.get('flags_inappropriate', 0)
             == resource.data.get('flags_unclear', 0) + resource.data.get('flags_inappropriate', 0) + 1
        && (!changed.hasAny(['status'])
            || (request.resource.data.status == 'flagged' && request.resource.data.flags >= 5));
    }

    // Admin roster. Presence of admins/{uid} grants admin.
    //
    // Sealed off from every client, in both directions. isAdmin() reaches it
    // with exists(), and get()/exists() inside rules are not subject to the
    // rules of the path they read -- so denying everything here costs nothing
    // and means no client can grant itself admin, discover who is an admin, or
    // remove one. Writes are console or Admin SDK only.
    // Invite-only sign-up. A profile can only be created with the invite code
    // of an existing member who has unlocked inviting (holds a member
    // number), and whose link has not been paused for abuse. Only the code
    // holder's uid is read, never anything about the new user.
    function inviteOk(code) {
      return code is string && code.size() > 0
        && exists(/databases/$(database)/documents/referralCodes/$(code))
        && inviterOk(get(/databases/$(database)/documents/referralCodes/$(code)).data);
    }
    function inviterOk(codeDoc) {
      return codeDoc.get('paused', false) != true
        && get(/databases/$(database)/documents/users/$(codeDoc.uid)).data.get('memberNumber', 0) > 0;
    }
    // A member number is set once, and only to the number the caller has just
    // claimed in memberNumbers/{n} in the same write. Numbers are unique
    // because claiming one advances counters/members by exactly one.
    function memberNumberClaimOk(userId) {
      return isOwner(userId)
        && resource.data.get('memberNumber', 0) == 0
        && request.resource.data.memberNumber is int
        && getAfter(/databases/$(database)/documents/memberNumbers/$(string(request.resource.data.memberNumber))).data.uid == request.auth.uid;
    }

    // Credits move only together with the action that earns or spends them.
    // The client records the reason in users/{uid}/private/credit in the same
    // write; each reason allows one exact amount and needs its proof created
    // in that write too, so nothing can be claimed twice or made up.
    function firstWrite(path) {
      return !exists(path) && existsAfter(path);
    }
    function creditOk(userId) {
      let r = getAfter(/databases/$(database)/documents/users/$(userId)/private/credit).data;
      let d = request.resource.data.credits - resource.data.get('credits', 0);
      return request.resource.data.credits is int
        && request.resource.data.credits >= 0
        && r.at == request.time
        && ((r.reason == 'answer' && d == 1 && firstWrite(/databases/$(database)/documents/user_answers/$(userId + '_' + r.ref)))
          || (r.reason == 'bracket' && d == 1 && firstWrite(/databases/$(database)/documents/bracketPicks/$(userId + '_' + r.ref)))
          || (r.reason == 'unlock' && d == -3 && firstWrite(/databases/$(database)/documents/users/$(userId)/unlockedDemographics/$(r.ref)))
          || (r.reason == 'referral' && d == 15 && firstWrite(/databases/$(database)/documents/referrals/$(userId)))
          || (r.reason == 'boost' && d == -10 && boostOk(r.ref))
          || (r.reason == 'daily' && d == 3 && dailyOk()));
    }
    function boostOk(questionId) {
      return getAfter(/databases/$(database)/documents/questions/$(questionId)).data.get('boostCount', 0)
        == get(/databases/$(database)/documents/questions/$(questionId)).data.get('boostCount', 0) + 100;
    }
    // The daily bonus: lastLogin moves to today (UTC, as the app writes it).
    function dailyOk() {
      let day = request.resource.data.get('lastLogin', '');
      return day is string && day.size() == 10
        && day != resource.data.get('lastLogin', '')
        && timestamp.date(int(day[0:4]), int(day[5:7]), int(day[8:10])) == request.time.date();
    }

    match /admins/{adminUid} {
      // A user may check only their OWN entry, so the app can show the review
      // queue to admins. It reveals nothing about who else is an admin.
      allow get: if isAuthenticated() && request.auth.uid == adminUid;
      allow list, write: if false;
    }

    // Beta tracking: per user per day, counts only (never which question or
    // which option). The owner may only create their own day's document and
    // only ever count upwards, one at a time.
    function counterStepOk(field) {
      return request.resource.data.get(field, 0) is int
             && request.resource.data.get(field, 0) >= (resource == null ? 0 : resource.data.get(field, 0))
             && request.resource.data.get(field, 0) <= (resource == null ? 0 : resource.data.get(field, 0)) + 1;
    }
    match /activity/{docId} {
      allow get: if isAdmin() || (isAuthenticated() && resource.data.uid == request.auth.uid);
      allow list: if isAdmin();
      allow create, update: if isAuthenticated()
        && request.resource.data.uid == request.auth.uid
        && docId == request.auth.uid + '_' + request.resource.data.day
        && request.resource.data.keys().hasOnly(['uid', 'day', 'sessions', 'answers', 'skips', 'shares'])
        && (resource == null || (resource.data.uid == request.resource.data.uid && resource.data.day == request.resource.data.day))
        && counterStepOk('sessions') && counterStepOk('answers') && counterStepOk('skips') && counterStepOk('shares');
      allow delete: if isAdmin();
    }

    // Member numbers, handed out in join order. counters/members holds the
    // last number issued. Claiming one is a single transaction: advance the
    // counter by one, record memberNumbers/{n} -> uid, and set the profile's
    // memberNumber. Each part checks the others with getAfter, so no number
    // can be skipped, reused, chosen, or claimed twice by one member.
    match /counters/{counterId} {
      allow get: if isAuthenticated() && counterId == 'members';
      allow list, create, delete: if isAdmin();
      allow update: if isAdmin()
        || (isAuthenticated() && counterId == 'members'
            && request.resource.data.keys().hasOnly(['last'])
            && request.resource.data.last == resource.data.last + 1
            && getAfter(/databases/$(database)/documents/memberNumbers/$(string(request.resource.data.last))).data.uid == request.auth.uid);
    }
    match /memberNumbers/{n} {
      allow get, list: if isAdmin();
      allow create: if isAdmin()
        || (isAuthenticated()
            && request.resource.data.keys().hasOnly(['uid'])
            && request.resource.data.uid == request.auth.uid
            && n == string(getAfter(/databases/$(database)/documents/counters/members).data.last)
            && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.memberNumber == int(n));
      allow update, delete: if isAdmin();
    }

    // ---------------------------------------------------------------
    // Knockout: 8-contender brackets. Round 1 pairs are fixed (0v1, 2v3,
    // 4v5, 6v7); later pairs depend on each member's own picks.
    //
    // picks = the 7 winners in order: [qf0, qf1, qf2, qf3, sf0, sf1, final].
    // A member's picks are private and written once. The community tally is
    // +1 per match the member actually played, on the side they picked, and
    // only in the same write that creates their picks: so it cannot be
    // replayed, inflated, or written for a match they never had.
    // ---------------------------------------------------------------
    function pickIn(p, i, a, b) {
      return p[i] is int && (p[i] == a || p[i] == b);
    }
    function picksOk(p) {
      return p is list && p.size() == 7
        && pickIn(p, 0, 0, 1) && pickIn(p, 1, 2, 3) && pickIn(p, 2, 4, 5) && pickIn(p, 3, 6, 7)
        && pickIn(p, 4, p[0], p[1]) && pickIn(p, 5, p[2], p[3]) && pickIn(p, 6, p[4], p[5]);
    }
    function pairKey(a, b) {
      return a < b ? string(a) + '-' + string(b) : string(b) + '-' + string(a);
    }
    // The tally for one match a-b moved by exactly +1 on the winner w.
    function pairOk(n, o, a, b, w) {
      let nm = n.get(pairKey(a, b), {});
      let om = o.get(pairKey(a, b), {});
      let ws = string(w);
      let ls = string(w == a ? b : a);
      return nm.keys().hasOnly([string(a), string(b)])
        && nm.get(ws, 0) == om.get(ws, 0) + 1
        && nm.get(ls, 0) == om.get(ls, 0);
    }
    function tallyOk(p, n, o) {
      return pairOk(n, o, 0, 1, p[0]) && pairOk(n, o, 2, 3, p[1])
        && pairOk(n, o, 4, 5, p[2]) && pairOk(n, o, 6, 7, p[3])
        && pairOk(n, o, p[0], p[1], p[4]) && pairOk(n, o, p[2], p[3], p[5])
        && pairOk(n, o, p[4], p[5], p[6])
        && n.diff(o).affectedKeys().hasOnly(['0-1', '2-3', '4-5', '6-7', pairKey(p[0], p[1]), pairKey(p[2], p[3]), pairKey(p[4], p[5])]);
    }
    function champOk(p, n, o) {
      let c = string(p[6]);
      return n.diff(o).affectedKeys().hasOnly([c])
        && n.get(c, 0) == o.get(c, 0) + 1;
    }
    // The caller's own picks, as they will stand after this write.
    function tallyWriteOk(bracketId) {
      let p = getAfter(/databases/$(database)/documents/bracketPicks/$(request.auth.uid + '_' + bracketId)).data.picks;
      let old = resource == null ? {} : resource.data;
      return tallyOk(p, request.resource.data.get('pairs', {}), old.get('pairs', {}))
        && champOk(p, request.resource.data.get('champ', {}), old.get('champ', {}));
    }

    match /brackets/{bracketId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    match /bracketPicks/{pickId} {
      // Keyed on the path, so "have I played this?" works before the record exists.
      allow get: if isAdmin() || (isAuthenticated() && pickId.matches(request.auth.uid + '_.+'));
      allow list: if isAdmin();
      allow create: if isAuthenticated()
        && pickId == request.auth.uid + '_' + request.resource.data.bracketId
        && request.resource.data.keys().hasOnly(['bracketId', 'picks', 'createdAt'])
        && exists(/databases/$(database)/documents/brackets/$(request.resource.data.bracketId))
        && get(/databases/$(database)/documents/brackets/$(request.resource.data.bracketId)).data.status == 'live'
        && picksOk(request.resource.data.picks);
      allow update, delete: if isAdmin();
    }
    match /bracketResults/{bracketId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin()
        || (isAuthenticated()
            && !exists(/databases/$(database)/documents/bracketPicks/$(request.auth.uid + '_' + bracketId))
            && existsAfter(/databases/$(database)/documents/bracketPicks/$(request.auth.uid + '_' + bracketId))
            && request.resource.data.keys().hasOnly(['pairs', 'champ'])
            && tallyWriteOk(bracketId));
      allow delete: if isAdmin();
    }
    // Ideas for future brackets. No author is stored.
    match /bracketSuggestions/{id} {
      allow create: if isAuthenticated()
        && request.resource.data.keys().hasOnly(['text', 'lang', 'createdAt'])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 1 && request.resource.data.text.size() <= 60
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if isAdmin();
    }

    // Waitlist for people without an invite. Anyone may add an email address;
    // nobody but an admin (the console / Admin SDK) can read the list.
    match /waitlist/{entryId} {
      allow create: if request.resource.data.keys().hasOnly(['email', 'lang', 'createdAt'])
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 200
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && request.resource.data.createdAt == request.time
        && (!request.resource.data.keys().hasAny(['lang']) || request.resource.data.lang in ['en', 'ar']);
      allow read, update, delete: if isAdmin();
    }

    // Operational documents written by the scheduled jobs (Admin SDK).
    // Only the question index is readable: the app checks new submissions
    // against it for duplicates. It holds live public question text only.
    match /ops/{docId} {
      allow get: if isAuthenticated() && docId in ['questionIndex', 'questionOfDay', 'questionOfWeek'];
      allow list, write: if false;
    }

    // User profiles
    match /users/{userId} {
      // `get` stays open to signed-in callers: games and groups display
      // usernames, which is a lookup by document ID.
      //
      // `list` is withdrawn. A collection scan returned every username with
      // demographics and credit balance, and one signed-in account was enough
      // to dump the whole user base. The three lookups that relied on it now
      // go through the usernames and referralCodes mappings below.
      allow get: if isAuthenticated();
      allow list: if isAdmin();
      // `role` is what isAdmin() consults, so a caller able to write it can
      // promote themselves and every isAdmin() gate in this file becomes
      // optional. Only an existing admin may set it. Nothing in the client
      // reads or writes `role` at all -- this is closing a door the app has
      // never used.
      //
      // The guard has to cover create as well as update. Signup writes this
      // document (AuthProvider step 3) AFTER the account exists, so requiring
      // ownership costs nothing -- and without it, a new account could simply
      // be created holding role:'admin', or an owner could delete their own
      // document and re-create it that way.
      allow create: if isOwner(userId)
                    && (isAdmin() || (request.resource.data.get('credits', 0) is int
                                      && request.resource.data.get('credits', 0) >= 0
                                      && request.resource.data.get('credits', 0) <= 13))
                    && (!request.resource.data.keys().hasAny(['role']) || isAdmin())
                    && (!request.resource.data.keys().hasAny(['memberNumber']) || isAdmin())
                    && (isAdmin() || inviteOk(request.resource.data.get('invitedWith', '')));
      allow update: if (isOwner(userId) || isAdmin() || isMigrating(userId))
                    // Cheap test first: isAdmin() costs an exists() plus a
                    // get() on every user write, including every credit change.
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])
                        || isAdmin())
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['memberNumber'])
                        || isAdmin()
                        || memberNumberClaimOk(userId))
                    // A migrating caller is retiring this old profile (it is
                    // deleted in the same sweep), so its balance is moot.
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['credits'])
                        || isAdmin()
                        || isMigrating(userId)
                        || creditOk(userId));
      allow delete: if isOwner(userId) || isAdmin() || isMigrating(userId);

      // Unlocked demographics subcollection
      // Proof that this user has paid to see one question's demographic
      // breakdown. `write` used to cover create, update and delete with no
      // field validation.
      //
      // An unlock is permanent. CLAUDE.md: once unlocked for a question, never
      // charge again -- which only holds if the record cannot be removed, since
      // deleting it is exactly how a user would be charged a second time.
      // Why the balance just moved, written in the same write as the change.
      // Private to the member; it names one question or bracket at most.
      match /private/{docId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId) && docId == 'credit'
          && request.resource.data.keys().hasOnly(['reason', 'ref', 'at'])
          && request.resource.data.at == request.time;
      }

      match /unlockedDemographics/{questionId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isAdmin()
                      || (isOwner(userId)
                          && request.resource.data.keys().hasOnly(['unlockedAt']));
        allow update, delete: if isAdmin();
      }
    }
    
    // Username -> uid. Replaces the collection scan that signup and the
    // sign-in migration sweep used to run.
    //
    // Safe to write because the document ID IS the username and every account
    // authenticates as `${username}@pulse.app`: only the caller Firebase Auth
    // has issued that token to can claim or move the mapping. This is the same
    // proof isMigrating() relies on.
    //
    // Note this is a lookup, not a uniqueness gate -- Auth already guarantees
    // uniqueness by rejecting a duplicate address at signup.
    match /usernames/{usernameLower} {
      allow get: if isAuthenticated();
      // Never listable: otherwise this becomes a second way to enumerate
      // everyone, which is the problem it was introduced to solve.
      allow list: if isAdmin();
      // An admin may write any mapping: the backfill script has to create
      // these for accounts that predate the change, and it cannot hold anyone
      // else's auth token.
      allow create, update: if isAdmin()
                            || (isAuthenticated()
                                && request.resource.data.keys().hasOnly(['uid'])
                                && request.resource.data.uid == request.auth.uid
                                && request.auth.token.email != null
                                && request.auth.token.email.lower() == usernameLower + '@pulse.app');
      allow delete: if isAdmin();
    }

    // Referral code -> uid. Replaces the scan in redeemReferral.
    //
    // The code is checked against the caller's own profile, so a squatter
    // cannot pre-register a code someone else will later generate and
    // intercept their referrals.
    match /referralCodes/{code} {
      allow get: if isAuthenticated();
      allow list: if isAdmin();
      allow create: if isAdmin()
                    || (isAuthenticated()
                        && request.resource.data.keys().hasOnly(['uid'])
                        && request.resource.data.uid == request.auth.uid
                        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.referralCode == code);
      // A code, once claimed, is never reassigned by its holder.
      allow update, delete: if isAdmin();
    }

    // A referral, recorded by the new user. The referrer's +15 is credited by
    // the scheduled job (Admin SDK): no client may change another user's
    // credits. One per user, created once, naming the real holder of the code,
    // never yourself. Readable only by the new user.
    match /referrals/{refereeUid} {
      allow get: if isOwner(refereeUid) || isAdmin();
      allow create: if isOwner(refereeUid)
                    && request.resource.data.keys().hasOnly(['code', 'referrerUid', 'createdAt'])
                    && request.resource.data.referrerUid != request.auth.uid
                    && request.resource.data.referrerUid ==
                         get(/databases/$(database)/documents/referralCodes/$(request.resource.data.code)).data.uid;
      allow update, delete: if isAdmin();
    }

    // Questions
    match /questions/{questionId} {
      allow get: if true;
      allow list: if isAuthenticated() && (
        isAdmin() || 
        resource.data.isPublic == true || 
        resource.data.authorUid == request.auth.uid ||
        resource.data.groupId != null
      );
      
      allow create: if isAuthenticated() && (
                      // Public question: always enters as 'pending'. Moderation
                      // runs server-side and is the only thing that can make it
                      // live; a client verdict cannot be trusted (the attacker
                      // bots wrote status 'live' directly).
                      (request.resource.data.isPublic == true
                       && request.resource.data.authorUid == request.auth.uid
                       && request.resource.data.status == 'pending') ||
                      // Group question (must be member of group)
                      (request.resource.data.isPublic == false && 
                       request.resource.data.groupId != null &&
                       isGroupMember(request.resource.data.groupId) &&
                       request.resource.data.authorUid == request.auth.uid) ||
                      // System (Pulse Originals) questions: admin only. Any
                      // signed-in user could previously post as the official
                      // account, straight to live.
                      isAdmin()
                    );
      
      allow update: if isAdmin()

                    // Flagging: any authenticated user other than the author.
                    || (isAuthenticated()
                        && resource.data.authorUid != request.auth.uid
                        && isFlagWrite())

                    // Boost: the author only, exactly +100 impressions.
                    || (isAuthenticated()
                        && resource.data.authorUid == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['boostCount'])
                        && request.resource.data.boostCount == resource.data.get('boostCount', 0) + 100)

                    // UID migration: authorUid and nothing else.
                    || (isAuthenticated()
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['authorUid'])
                        && request.resource.data.authorUid == request.auth.uid
                        && isMigrating(resource.data.authorUid));
      
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.groupId != null && 
                                     request.auth.uid == get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.adminUid);
    }

    // Results
    match /results/{questionId} {
      // Authentication only. This stops anonymous scraping of the demographic
      // map; it does NOT enforce the minimum-10 threshold or the 3-credit
      // unlock, both of which remain client-side. Rules cannot apply a
      // threshold to a map read -- the whole document is returned or none of
      // it is. See AUTOMATION_SETUP.md finding 2.
      allow read: if isAuthenticated();

      // Aggregate counts only. Written as a single +1 by a caller who holds an
      // answer record proving they voted, and only on the option and the
      // demographic bucket that record and their own profile attest to.
      //
      // Counts may never decrease. That is deliberate: an attacker able to zero
      // a results doc and then watch the next vote land would learn that
      // voter's choice and demographic bucket, defeating the min-10 threshold.

      // First vote on a question: the doc is created holding exactly one vote,
      // matching the answer record the client wrote immediately before this.
      allow create: if isAuthenticated()
        && hasAnswered(questionId)
        && request.resource.data.keys().hasOnly(['counts', 'demographics'])
        && request.resource.data.counts.keys().hasOnly(['0', '1'])
        && request.resource.data.counts.get('0', 0) is int
        && request.resource.data.counts.get('1', 0) is int
        && voteTotal(request.resource.data) == 1
        && request.resource.data.counts.get(callerAnswerIndex(questionId), 0) == 1
        && demoCreateOk(request.resource.data.get('demographics', {}), callerAnswerIndex(questionId));

      // Every subsequent vote: exactly +1, never a decrement, never a new field.
      allow update: if isAuthenticated()
        && hasAnswered(questionId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['counts', 'demographics'])
        && request.resource.data.counts.keys().hasOnly(['0', '1'])
        && voteTotal(request.resource.data) == voteTotal(resource.data) + 1
        && request.resource.data.counts.get('0', 0) >= resource.data.counts.get('0', 0)
        && request.resource.data.counts.get('1', 0) >= resource.data.counts.get('1', 0)
        && request.resource.data.counts.get(callerAnswerIndex(questionId), 0)
             == resource.data.counts.get(callerAnswerIndex(questionId), 0) + 1
        && demoUpdateOk(request.resource.data.get('demographics', {}),
                        resource.data.get('demographics', {}),
                        callerAnswerIndex(questionId));

      allow delete: if isAdmin();
    }

    // Groups
    match /groups/{groupId} {
      // The document no longer carries a `members` array. It held every
      // member's UID and was readable by anyone signed in, while the members
      // tab is only ever meant to show a count. Membership now lives in the
      // members subcollection below, where each document is private to its
      // owner, and the group carries `memberCount` instead.
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
                    request.resource.data.adminUid == request.auth.uid &&
                    request.resource.data.memberCount == 1 &&
                    !request.resource.data.keys().hasAny(['members']);

      // Only `memberCount` may change, and only by one, and only in step with
      // the caller's own membership document. Renaming, reassigning the admin
      // and rotating the invite code still have no call site and are refused.
      allow update: if isAdmin()
                    || (isAuthenticated()
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount'])
                        && (
                          // Join: your membership document now exists, so the
                          // count goes up by one. The invite-code proof is
                          // enforced on that document's create.
                          (request.resource.data.memberCount == resource.data.memberCount + 1
                           && isGroupMember(groupId))
                          ||
                          // Leave: your membership document is gone, so the
                          // count goes down by one.
                          (request.resource.data.memberCount == resource.data.memberCount - 1
                           && !isGroupMember(groupId))
                        ));
      allow delete: if isAuthenticated() && (request.auth.uid == resource.data.adminUid || isAdmin());

      // Membership, one document per member.
      //
      // Read is restricted to the member themselves, so no client can
      // enumerate a group's roster -- the members tab shows `memberCount` off
      // the parent document and nothing else. "My groups" is a collectionGroup
      // query on `uid`, which returns only the caller's own documents.
      match /members/{memberUid} {
        // Keyed on the path, not resource.data: the join flow asks "am I
        // already a member?" BEFORE joining, when the document does not
        // exist. resource is null then, and a resource.data check errors and
        // denies -- which broke join-by-code for everyone. The path is the
        // caller's own uid, so this still reveals nothing about anyone else.
        allow get: if isAdmin()
                   || (isAuthenticated() && memberUid == request.auth.uid);
        // Keyed on the document field rather than the path wildcard, because
        // that is what Firestore can prove a query's filter against: a
        // collectionGroup query for `uid == me` is allowed, and any broader
        // query is refused outright rather than per document.
        allow list: if isAuthenticated() && resource.data.uid == request.auth.uid;
        // Joining: yourself only, having proved the invite code -- except for
        // the group's own creator, who has no proof because they invented the
        // code. Without that exception the creator is never a member of their
        // own group: memberCount says 1, the roster is empty, the group
        // vanishes from their list, and they cannot post to it.
        allow create: if isOwner(memberUid)
                      && request.resource.data.keys().hasOnly(['uid', 'joinedAt'])
                      && request.resource.data.uid == request.auth.uid
                      && (request.auth.uid ==
                            get(/databases/$(database)/documents/groups/$(groupId)).data.adminUid
                          || hasJoinProof(groupId,
                               get(/databases/$(database)/documents/groups/$(groupId)).data.inviteCode));
        allow update: if false;
        // Leaving: yourself only. The group admin may also remove a member.
        allow delete: if isOwner(memberUid)
                      || isAdmin()
                      || (isAuthenticated()
                          && request.auth.uid == get(/databases/$(database)/documents/groups/$(groupId)).data.adminUid);
      }

      // Proof that the caller knew the invite code.
      //
      // The comparison happens here, server-side, against the group document.
      // A caller can only create this for themselves, and only by submitting
      // the code that the group actually holds -- so the group update rule can
      // treat its existence as proof. The document is private to its owner.
      match /joinRequests/{requesterUid} {
        // create AND update: the client stages proof with setDoc, which
        // Firestore evaluates as an update when the document already exists.
        // Someone who leaves a group and rejoins later hits exactly that path,
        // as does any retry. The same server-side comparison runs on every
        // write, so an update can no more forge a proof than a create can.
        allow create, update: if isAuthenticated()
                      && request.auth.uid == requesterUid
                      && request.resource.data.keys().hasOnly(['code'])
                      && request.resource.data.code ==
                           get(/databases/$(database)/documents/groups/$(groupId)).data.inviteCode;
        allow read, delete: if isOwner(requesterUid) || isAdmin();
      }
    }

    // User Answers (Tracking)
    match /user_answers/{answerId} {
      // get: the feed asks "have I answered this?" for every card, usually
      // before an answer exists. A missing document must not error (that was
      // an uncaught crash on every new card), but it may only be probed on the
      // caller's OWN id -- otherwise "missing" vs "denied" would reveal whether
      // someone else answered a question.
      allow get: if isAuthenticated() && (isAdmin()
                    || (resource == null && answerId.matches(request.auth.uid + '_.+'))
                    || (resource != null && resource.data.userId == request.auth.uid));
      allow list: if isAuthenticated() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      // Revisit rewrites the caller's own answer record. userId is pinned on
      // both sides so a record can never be reassigned to another user, and
      // questionId is immutable.
      allow update: if isAdmin()
                    || (isAuthenticated()
                        && resource.data.userId == request.auth.uid
                        && request.resource.data.userId == request.auth.uid
                        && request.resource.data.questionId == resource.data.questionId);
      allow delete: if isAdmin() || isOwner(resource.data.userId);
    }

    // Skipped Questions
    match /skipped_questions/{skipId} {
      allow read: if isAuthenticated() && (isAdmin() || resource.data.userId == request.auth.uid);

      allow create: if isAdmin()
                    || (isAuthenticated()
                        && request.resource.data.keys().hasOnly(['userId', 'questionId', 'skippedAt'])
                        && request.resource.data.userId == request.auth.uid);

      // Update matters because the skip id is deterministic --
      // `${uid}_${questionId}` -- so skipping the same question again, or any
      // retry after a failed write, is a setDoc over an existing document,
      // which Firestore evaluates as an update. Restricting this to admins
      // made re-skipping fail with a permission error.
      //
      // Both sides are pinned to the caller, so a record can never be
      // reassigned or overwritten by anyone else.
      allow update: if isAdmin()
                    || (isAuthenticated()
                        && request.resource.data.keys().hasOnly(['userId', 'questionId', 'skippedAt'])
                        && request.resource.data.userId == request.auth.uid
                        && resource.data.userId == request.auth.uid);

      allow delete: if isAdmin() || isOwner(resource.data.userId);
    }

    // Games
    match /games/{gameId} {
      // Game documents carry `answers` and `predictions` keyed by player UID.
      // Only players may read a game that has started.
      //
      // Joining by code (GameHome joinGame) queries games by inviteCode before
      // the caller is a player, so that read has to keep working. Rules cannot
      // inspect a query's where-clauses, so "knows the code" is not checkable;
      // what is checkable is that the game has not started. A lobby game holds
      // no answers or predictions yet, so exposing it reveals no one's choices.
      allow read: if isAuthenticated() && (
                    request.auth.uid in resource.data.players ||
                    resource.data.status == 'lobby'
                  );
      
      // Create allowed for any authenticated user
      allow create: if isAuthenticated() && 
                    request.resource.data.hostUid == request.auth.uid &&
                    request.resource.data.players.hasAll([request.auth.uid]);
      
      // Update allowed for players in the game
      allow update: if isAuthenticated() && (
        // Joining: a lobby game only, adding yourself and no one else.
        //
        // Without the status gate, anyone holding a game ID could add
        // themselves to a game in progress and then satisfy the read rule
        // above, exposing every player's answers and predictions. Without the
        // caller pinning, an existing player could drag arbitrary UIDs in.
        //
        // No affectedKeys restriction here on purpose: GameHome.joinGame
        // writes `players` and `scores.<uid>` in the same update.
        (resource.data.status == 'lobby' &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['players', 'scores']) &&
         ownKeyOnly(resource.data, request.resource.data, 'scores') &&
         request.resource.data.players.hasAll(resource.data.players) &&
         request.resource.data.players.size() == resource.data.players.size() + 1 &&
         !(request.auth.uid in resource.data.players) &&
         request.auth.uid in request.resource.data.players) ||

        // Leaving: remove yourself and no one else (GameLobby leaveGame).
        (request.auth.uid in resource.data.players &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['players']) &&
         resource.data.players.hasAll(request.resource.data.players) &&
         request.resource.data.players.size() == resource.data.players.size() - 1 &&
         !(request.auth.uid in request.resource.data.players)) ||

        // Host: game progression only. Notably NOT `players` -- the host has
        // no path to add or remove anyone.
        (request.auth.uid == resource.data.hostUid &&
         gameStatusOk() &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(
           ['status', 'currentQuestionIndex', 'scores', 'scoredQuestions',
            'deadline', 'questionsPerPlayer', 'lastUpdated'])) ||

        // Players: their own answer, their own prediction, their own question
        // submission. Never another player's, and never `players` itself.
        (request.auth.uid in resource.data.players &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(
           ['answers', 'predictions', 'playerQuestions', 'questions', 'lastUpdated']) &&
         ownKeyOnly(resource.data, request.resource.data, 'answers') &&
         ownEntriesAppendOnly(resource.data, request.resource.data, 'answers') &&
         ownEntriesAppendOnly(resource.data, request.resource.data, 'predictions') &&
         ownKeyOnly(resource.data, request.resource.data, 'predictions') &&
         ownKeyOnly(resource.data, request.resource.data, 'playerQuestions') &&
         questionSubmissionOk()) ||

        isAdmin()
      );
      
      allow delete: if isAdmin() || (isAuthenticated() && request.auth.uid == resource.data.hostUid);
    }

    // Game Questions
    // Game questions carry NO authorship. They used to hold authorUid and
    // authorUsername, readable by every player from the moment of submission,
    // while CLAUDE.md says the author is revealed only on the final results
    // screen. Authorship now lives in game_question_authors below, gated on the
    // game being finished.
    match /game_questions/{questionId} {
      allow read: if isAuthenticated() &&
                    request.auth.uid in get(/databases/$(database)/documents/games/$(resource.data.gameId)).data.players;

      allow create: if isAuthenticated() &&
                    request.resource.data.keys().hasOnly(['gameId', 'text', 'options', 'createdAt']) &&
                    request.auth.uid in get(/databases/$(database)/documents/games/$(request.resource.data.gameId)).data.players;

      // No client path updates or deletes a game question.
      allow update, delete: if isAdmin();
    }

    // Who submitted which game question.
    //
    // Readable only once the game is finished, which is when the summary screen
    // is allowed to attribute questions. Before that a player can read the
    // question but not who wrote it.
    match /game_question_authors/{questionId} {
      allow read: if isAuthenticated() &&
                    request.auth.uid in get(/databases/$(database)/documents/games/$(resource.data.gameId)).data.players &&
                    get(/databases/$(database)/documents/games/$(resource.data.gameId)).data.status == 'finished';

      allow create: if isAuthenticated() &&
                    request.resource.data.keys().hasOnly(['gameId', 'authorUid', 'authorUsername']) &&
                    request.resource.data.authorUid == request.auth.uid &&
                    request.auth.uid in get(/databases/$(database)/documents/games/$(request.resource.data.gameId)).data.players;

      // Immutable: attribution is written once, at submission.
      allow update, delete: if isAdmin();
    }
  }
}
