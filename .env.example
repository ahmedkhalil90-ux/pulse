# Only variables prefixed with VITE_ are exposed to client code, via
# import.meta.env. Anything without the prefix stays server-side and is never
# bundled.
#
# WARNING: VITE_-prefixed values ARE readable by anyone who opens the shipped
# JavaScript. Do not put a secret here that must stay secret.

# VITE_GEMINI_API_KEY: Required for Gemini AI moderation calls.
# Set this in the AI Studio Secrets panel under this exact name (it was
# previously named GEMINI_API_KEY). Without it, moderation throws and falls
# through to its default, publishing questions unmoderated.
VITE_GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
# Not prefixed: server-side only, never reaches the client.
APP_URL="MY_APP_URL"
